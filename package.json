{
  "name": "computedistribute",
  "version": "1.0.0",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "agent": "node --env-file-if-exists=.env agent/agent.js",
    "create-account": "node --env-file-if-exists=.env scripts/create-account.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
