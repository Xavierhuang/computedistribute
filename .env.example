PORT=3000
# Local dev database (see README for starting it)
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/computedistribute
# Seconds a worker owns a job without heartbeating before it is requeued
LEASE_SECONDS=60

# Worker agent (npm run agent)
CD_API_URL=http://localhost:3000
CD_HOST_KEY=
CD_WORKER_ID=
CD_VRAM_GB=0
