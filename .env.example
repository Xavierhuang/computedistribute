PORT=3000
# Local dev database (see README for starting it)
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/computedistribute
# Seconds a worker owns a job without heartbeating before it is requeued
LEASE_SECONDS=60
# Share of successful jobs re-run on a different host to verify the result (0-1)
VERIFY_RATE=0.05
# Public URL of this server (Stripe return links; https also makes cookies Secure)
PUBLIC_URL=http://localhost:3000
# Set to 1 behind a reverse proxy so rate limits see the real client IP
TRUST_PROXY=
# Enables /v1/admin. Use a long random value.
ADMIN_TOKEN=
# Card top-ups (both required): Stripe secret key and the webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Worker agent (npm run agent)
CD_API_URL=http://localhost:3000
CD_HOST_KEY=
CD_WORKER_ID=
CD_VRAM_GB=0
# Python with faster-whisper (see agent/requirements.txt); enables "transcribe" jobs
CD_PYTHON=
CD_MAX_DOWNLOAD_MB=500
